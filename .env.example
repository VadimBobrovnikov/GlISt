# GlISt — пример переменных окружения (задача T005).
#
# Скопируйте в .env:   cp .env.example .env
# Файл .env в .gitignore; секреты живут ТОЛЬКО здесь (конституция, Принцип IX).
# Значения CHANGE_ME_* замените сгенерированными секретами:
#   openssl rand -hex 32                      (Linux / macOS / Git Bash)
#   PowerShell: -join ((1..32) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# Стенд стартует только с заполненными обязательными переменными (`${VAR:?}` в docker-compose.yml).

# ------------------------------------------------------- PostgreSQL (alembic и инструменты с хоста)
# В контейнерах api/worker docker-compose.yml перекрывает DATABASE_URL адресом сервиса `postgres`.
DATABASE_URL=postgresql+asyncpg://glist:CHANGE_ME_DB_PASSWORD@localhost:5432/glist
POSTGRES_USER=glist
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=glist

# ------------------------------------------------------- Redis (общий: ARQ — БД 0, LangFuse — БД 1)
REDIS_URL=redis://:CHANGE_ME_REDIS_AUTH@localhost:6379/0
REDIS_AUTH=CHANGE_ME_REDIS_AUTH

# ------------------------------------------------------- LangFuse (трассировка — Принцип III, NON-NEGOTIABLE)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_URL=http://localhost:3000
# LANGFUSE_*_KEY и LANGFUSE_INIT_*_KEY должны совпадать: INIT-переменные создают проект
# при первом старте стенда, SDK использует LANGFUSE_*_KEY для отправки трасс.
LANGFUSE_PUBLIC_KEY=CHANGE_ME_LF_PUBLIC_KEY
LANGFUSE_SECRET_KEY=CHANGE_ME_LF_SECRET_KEY
LANGFUSE_INIT_PUBLIC_KEY=CHANGE_ME_LF_PUBLIC_KEY
LANGFUSE_INIT_SECRET_KEY=CHANGE_ME_LF_SECRET_KEY
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=GlISt
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=GlISt
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME_LF_ADMIN_PASSWORD
# Внутренности LangFuse v4 (см. docker-compose.yml).
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=CHANGE_ME_LF_DB_PASSWORD
LANGFUSE_SALT=CHANGE_ME_SALT_32_BYTES
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_32_BYTES
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME_CH_PASSWORD

# ------------------------------------------------------- MinIO (EOL: plan.md → Complexity Tracking, №5)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_MIN_8

# ------------------------------------------------------- LLM-провайдер (абстракция LLMProvider, Принцип VI)
LLM_PROVIDER=openai
# LLM_PROVIDER: openai | ollama
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
# Опционально; обязателен при LLM_PROVIDER=openai. Только через переменные окружения.
OPENAI_API_KEY=

# ------------------------------------------------------- Воспроизводимость и геокодирование
SEED=42
OSM_USER_AGENT=GlISt-Research/0.1 (change_me@example.org)
ARTIFACTS_DIR=./data/artifacts
